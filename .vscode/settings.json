{
  "latex-workshop.latex.tools": [
    {
      "name": "cv-lualatexmk",
      "command": "latexmk",
      "args": [
        "-lualatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "-outdir=%OUTDIR%",
        "%DOC%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "LuaLaTeX (latexmk)",
      "tools": [
        "cv-lualatexmk"
      ]
    }
  ],
  "latex-workshop.latex.recipe.default": "LuaLaTeX (latexmk)"
}
